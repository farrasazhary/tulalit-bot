# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CHANNEL_ID=your_discord_channel_id_here
CONFESSION_CHANNEL_ID=your_confession_channel_id_here

# Gemini AI API Key Configuration (Bisa isi 1 key atau banyak key dipisahkan koma)
# Contoh 1 key: AI_API_KEY=AIzaSy...
# Contoh banyak key (multi-account rotation): AI_API_KEYS=key_akun1,key_akun2,key_akun3
AI_API_KEY=your_gemini_api_key_here

# Groq AI API Key Configuration (Fallback, bisa 1 key atau banyak key dipisahkan koma)
# Contoh banyak key: GROQ_API_KEYS=gsk_akun1,gsk_akun2
GROQ_API_KEY=your_groq_api_key_here

# Web Server Port Configuration
PORT=3005

